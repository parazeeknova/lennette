# Optional overrides shared by local app commands. Copy to .env.local.
# .env.local is ignored; never put real credentials in .env.development.
# Uncomment only what you need to override.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MERGE_API_KEY=
# DEEPGRAM_API_KEY=
# RESEND_API_KEY=
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_STANDARD_PRODUCT_ID=
# DODO_PLUS_PRODUCT_ID=
# Private R2 S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
# Use the jurisdiction-specific endpoint for EU/FedRAMP buckets.
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Private ClamAV daemon (keep off the public internet); mandatory for uploads.
# CLAMD_ADDRESS=clamav:3310
# Only proxy socket IPs you control; origin must accept traffic solely from Cloudflare.
# TRUSTED_PROXY_IPS=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# To change local database passwords, also update DATABASE_URL / REDIS_URL.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
