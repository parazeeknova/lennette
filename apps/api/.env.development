# Committed local defaults only. Put real credentials and overrides in root .env.local.
API_BIND=127.0.0.1:8090
API_PUBLIC_URL=http://localhost:8090
WEBSITE_URL=http://localhost:8080
DATABASE_URL=postgres://lennette:local-development-only@127.0.0.1:55432/lennette
REDIS_URL=redis://:local-development-only@127.0.0.1:56379/0
# Attachments require a private R2 bucket; configure all four values in root .env.local.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional at startup; uploads fail closed unless malware scanning is configured.
CLAMD_ADDRESS=127.0.0.1:53310
RUST_LOG=info,sqlx=warn
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=lennette-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.namespace=lennette

# Register callbacks at /v1/auth/{google,github}/callback on API_PUBLIC_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MERGE_API_KEY=
DEEPGRAM_API_KEY=

# Dodo sandbox. Production configuration belongs in Dokploy.
DODO_API_URL=https://test.dodopayments.com/
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_STANDARD_PRODUCT_ID=
DODO_PLUS_PRODUCT_ID=
MOBILE_REDIRECT_URIS=

# Loopback-only development ingestion credentials; override for your deployment.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20ZGV2QGxlbm5ldHRlLmxvY2FsOkxvY2FsT25seS1PYnNlcnZlMTIzIQ==,stream-name=lennette_api
