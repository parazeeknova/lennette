API_BIND=127.0.0.1:8090
API_PUBLIC_URL=http://127.0.0.1:8090
WEBSITE_URL=https://lennette.itssingularity.com
DATABASE_URL=postgres://lennette:local-development-only@127.0.0.1:55432/lennette
REDIS_URL=redis://:local-development-only@127.0.0.1:56379/0
ATTACHMENT_DIR=./data/attachments
RUST_LOG=info,sqlx=warn

# For production: API_PUBLIC_URL=https://lennapi.itssingularity.com
# Register /v1/auth/google/callback and /v1/auth/github/callback on that origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MERGE_API_KEY=
DEEPGRAM_API_KEY=

# Create recurring USD 17.10 and USD 40.00 products under the Lennette business.
# Keep test and live credentials/product IDs separate.
DODO_API_URL=https://test.dodopayments.com/
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_STANDARD_PRODUCT_ID=
DODO_PLUS_PRODUCT_ID=

# Optional HTTPS universal links for a future mobile app, comma-separated.
MOBILE_REDIRECT_URIS=
