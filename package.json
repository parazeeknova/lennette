{
  "name": "lennette-workspace",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --no-env-file scripts/dev.ts",
    "dev:setup": "bun scripts/dev-setup.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run dev:setup && bun run --cwd apps/api dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "payments:listen": "bun --no-env-file scripts/dodo-listen.ts",
    "build": "lerna run build --concurrency 1",
    "check": "lerna run typecheck --concurrency 1",
    "lint": "lerna run lint --concurrency 1",
    "format": "cargo fmt --all && bun run --cwd apps/web format",
    "test": "lerna run test --concurrency 1",
    "test:dev-env": "bun --no-env-file test scripts/dev-env.test.ts",
    "test:integration": "bun --no-env-file scripts/dev-env.ts api cargo test -p lennette-server --tests -- --ignored",
    "infra:up": "bun scripts/infra.ts up",
    "infra:down": "bun scripts/infra.ts down",
    "db:migrate": "bun run --cwd apps/api migrate"
  },
  "devDependencies": {
    "@neon/config": "^1.10.1",
    "cross-env": "^10.1.0",
    "lerna": "^10.1.1"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "packageManager": "bun@1.4.4"
}
