// Expanded from Cargo.toml by build.rs. Explorer, Setup and the app share identity.
1 ICON "@ICON_PATH@"
1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "@PUBLISHER@\0"
      VALUE "FileDescription", "@DESCRIPTION@\0"
      VALUE "FileVersion", "@VERSION@\0"
      VALUE "InternalName", "@APP_ID@\0"
      VALUE "OriginalFilename", "lennette.exe\0"
      VALUE "ProductName", "@APP_NAME@\0"
      VALUE "ProductVersion", "@VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
